    remote isolated function listAttendanceForSchool(string schoolId, map<string|string[]> headers = {}, *ListAttendanceForSchoolQueries queries) returns AttendanceResponse|error {
        string resourcePath = string `/attendance/schools/${getEncodedUri(schoolId)}`;
        resourcePath = resourcePath + check getPathForQueryParam(queries);
        return self.clientEp->get(resourcePath, headers);
    }

    # Returns a list of attendance records for a section
    #
    # + sectionId - ID of the section
    # + headers - Headers to be sent with the request 
    # + queries - Queries to be sent with the request 
    # + return - OK Response 
    remote isolated function listAttendanceForSection(string sectionId, map<string|string[]> headers = {}, *ListAttendanceForSectionQueries queries) returns AttendanceResponse|error {
        string resourcePath = string `/attendance/sections/${getEncodedUri(sectionId)}`;
        resourcePath = resourcePath + check getPathForQueryParam(queries);
        return self.clientEp->get(resourcePath, headers);
    }

    # List data change events
    #
    # + headers - Headers to be sent with the request 
    # + queries - Queries to be sent with the request 
    # + return - OK Response 
    remote isolated function getEvents(map<string|string[]> headers = {}, *GetEventsQueries queries) returns EventsResponse|error {
        string resourcePath = string `/events`;
        map<Encoding> queryParamEncoding = {"record_type": {style: FORM, explode: true}};
        resourcePath = resourcePath + check getPathForQueryParam(queries, queryParamEncoding);
        return self.clientEp->get(resourcePath, headers);
    }

    # Get a data change event
    #
    # + id - ID of the event
    # + headers - Headers to be sent with the request 
    # + return - OK Response 
    remote isolated function getEvent(string id, map<string|string[]> headers = {}) returns EventResponse|error {
        string resourcePath = string `/events/${getEncodedUri(id)}`;
        return self.clientEp->get(resourcePath, headers);
    }
}
